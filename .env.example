# Développement local : Postgres lancé à part, ex.
#   docker run -d --name portfolio-postgres -e POSTGRES_USER=payload -e POSTGRES_PASSWORD=payload \
#     -e POSTGRES_DB=portfolio -p 127.0.0.1:54329:5432 -v portfolio-pgdata:/var/lib/postgresql/data postgres:17-alpine
DATABASE_URL=postgres://payload:payload@127.0.0.1:54329/portfolio
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Destinataire des notifications du formulaire de contact (nécessite un adaptateur e-mail)
CONTACT_NOTIFICATION_EMAIL=contact@gabrielhalus.com

# Production (docker-compose.yml / Dokploy) : DATABASE_URL est construit à partir de
# POSTGRES_USER=payload
# POSTGRES_PASSWORD=
# POSTGRES_DB=portfolio
